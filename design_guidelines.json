  "instructions_to_main_agent": {
    "setup": [
      "Install `expo-linear-gradient` for creating the 'Aurora' effects and button gradients.",
      "Use `expo-blur` (already installed) for glassmorphic overlays in headers and modals.",
      "Use `expo-image` for high-performance image loading.",
      "Ensure all interactive elements have a minimum hit slop of 10px and height of 44px."
    ],
    "styling_rules": [
      "NEVER use inline styles for complex components. Use `StyleSheet.create`.",
      "Avoid 'pure black' (#000) for cards; use #1C1C1E to maintain depth.",
      "Use `rgba(255, 59, 48, 0.8)` (Brand Red) for primary actions.",
      "Text over images MUST have a gradient overlay or text shadow for readability."
    ],
    "animations": [
      "Use `LayoutAnimation` for list layout changes (adding/removing items).",
      "Use `Animated` API for simple opacity/transform transitions."
    ],
    "accessibility": [
      "All `TouchableOpacity` or `Pressable` must have `accessibilityLabel`.",
      "Contrast ratio is critical in Dark Mode. Ensure grey text (#8E8E93) is not used for essential data."
    ]
  },
  "UNIVERSAL_GUIDELINES": [
    "Dark colors look good when used independently without gradients. DO NOT use dark colors as gradients.",
    "Don't make generic centered layouts. Use left alignment for body text.",
    "Create depth through layered design elements (Background > Card > Content).",
    "Use glass-morphism effects with `BlurView` (tint='dark', intensity=80).",
    "NEVER use AI assistant Emoji characters like 🤖 etc.",
    "Every interaction needs micro-feedback (opacity change on press).",
    "Use 2-3x more spacing than feels comfortable.",
    "Missing categories/logos = use placeholder text (FORBIDDEN). Use a generic relevant icon instead."
  ]
}
