# BORAROC backend — environment template (PR-3). Copy to backend/.env and fill in.
# No real secrets here; placeholders only.

# --- Database (required) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=boraroc

# --- Auth (required in production) ---
# Must be a long random string (>= 32 chars). Used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# --- App mode / CORS ---
# APP_ENV: "dev" (default) or "production". Production enforces stricter secret checks.
APP_ENV=dev
# Comma-separated allowed origins for CORS. Dev falls back to "*" when unset.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- SMS / OTP (MSG91) — warning-only if unset in non-prod ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI (Emergent LLM) ---
EMERGENT_LLM_KEY=
