{
  "expo": {
    "name": "BORAROC",
    "slug": "boraroc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "boraroc",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boraroc.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload dish photos to your café menu",
        "NSCameraUsageDescription": "Take photos of dishes for the menu"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F1C30"
      },
      "package": "com.boraroc.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload dish photos to your café menu",
          "cameraPermission": "Take photos of dishes for the menu"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1C30"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BORAROC uses your location to detect your delivery address."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/mobile"
    }
  }
}
